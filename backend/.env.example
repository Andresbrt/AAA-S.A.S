# ═══════════════════════════════════════════════════════════════
# ENVIRONMENT VARIABLES — AAA S.A.S. Backend
# Copy this file to .env and fill in the values
# ═══════════════════════════════════════════════════════════════

# ── Spring Profile ─────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=local

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=jdbc:postgresql://localhost:5432/aaasas_inmobiliaria
DATABASE_USERNAME=
DATABASE_PASSWORD=
DB_POOL_MAX=10
DB_POOL_MIN=2

# ── JWT ────────────────────────────────────────────────────────
# Generar con: openssl rand -base64 48
JWT_SECRET=

# ── CORS ───────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Admin Seed ─────────────────────────────────────────────────
ADMIN_EMAIL=admin@aaasas.com
ADMIN_PASSWORD=change-me-secure-password
ADMIN_NAME=Super Admin

# ── Storage ────────────────────────────────────────────────────
STORAGE_PROVIDER=s3

# ── AWS S3 (if STORAGE_PROVIDER=s3) ───────────────────────────
AWS_S3_BUCKET=aaasas-media
AWS_S3_REGION=us-east-1
AWS_S3_ACCESS_KEY=
AWS_S3_SECRET_KEY=

# ── Supabase (if STORAGE_PROVIDER=supabase) ───────────────────
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=media

# ── SMTP ───────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
